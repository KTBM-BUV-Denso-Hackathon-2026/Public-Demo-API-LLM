# =============================================================================
# llm_api — mẫu cấu hình. Copy thành .env rồi sửa giá trị thật:
#   cp .env.example .env
# =============================================================================

# --- Nhà cung cấp LLM ------------------------------------------------------
# openai_compatible : gọi LMDeploy/vLLM/OpenAI qua HTTP (dùng cho production).
# mock              : trả lời giả lập, KHÔNG cần GPU — chỉ dùng dev/test.
LLM_PROVIDER=mock

# Điền khi LLM_PROVIDER=openai_compatible:
#   LMDeploy: lmdeploy serve api_server Qwen/Qwen2.5-7B-Instruct --server-port 23333
LM_DEPLOY_BASE_URL=http://localhost:23333/v1
LM_DEPLOY_API_KEY=EMPTY
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
DEFAULT_TEMPERATURE=0.7
DEFAULT_TOP_P=0.8
DEFAULT_MAX_NEW_TOKENS=512
LLM_REQUEST_TIMEOUT=120
# Độ trễ giả lập cho từng token khi dùng provider mock (ms).
MOCK_STREAM_DELAY_MS=0

# --- RAG -------------------------------------------------------------------
RAG_ENABLED=true
RAG_TOP_K=5
# Bảng chunk + vector (khớp db_table của RagChunkData trong denso_backend).
RAG_CHUNK_TABLE=rag_chunkdata
# Model embedding PHẢI khớp model mà rag_worker dùng khi nạp dữ liệu.
EMBEDDING_MODEL=bkai-foundation-models/vietnamese-bi-encoder
# PHẢI khớp cột `vector` trong rag_chunkdata (mặc định 768 chiều).
EMBEDDING_DIM=768
# Bật để raise lỗi ngay khi số chiều lệch (khuyến nghị).
STRICT_EMBEDDING_DIM=true
EMBEDDING_BATCH_SIZE=32

# --- Database (CHUNG với denso_backend và rag_worker) ----------------------
# Dùng CHUNG một PostgreSQL: rag_rawdata.user_id là FK tới core_users nên
# không thể tách "vector DB" riêng. GIÁ TRỊ NÀY PHẢI GIỐNG HỆT DATABASE_URL
# trong denso_backend/.env và rag_worker/.env.
# GIÁ TRỊ MẪU khớp docker-compose.yml (database=denso, user=denso, pass=denso).
DATABASE_URL=postgresql://denso:denso@localhost:5432/denso
DB_POOL_MIN=1
DB_POOL_MAX=10
# Số lần thử lại khi connection pooler của cloud Postgres (Neon/Supabase —
# hostname có chữ "-pooler") đã chủ động đóng kết nối rảnh trong lúc ta vẫn
# giữ nó trong pool. Không có kiểm tra này, request sẽ lỗi:
#   psycopg2.OperationalError: SSL SYSCALL error ... connection abort
# Đặt 1 nếu DB local (docker compose) không qua pooler.
DB_PREPING_ATTEMPTS=2

# --- Xác thực nội bộ -------------------------------------------------------
# Shared-secret mà denso_backend gửi kèm header `X-Internal-Token` cho
# POST /chat và POST /chat/batch. PHẢI BẰNG `LLM_API_TOKEN` trong
# denso_backend/.env.
# Rỗng = tắt auth (chỉ dành cho localhost). Production BẮT BUỘC đặt.
# Sinh: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=

# --- Giới hạn đầu vào ------------------------------------------------------
# Khớp AskRequestSerializer.question của denso_backend.
MAX_QUESTION_LENGTH=8000
# Trần cứng cho lịch sử. denso_backend tự cắt bớt theo LLM_MAX_HISTORY_MESSAGES
# (mặc định 100) nên bình thường không bao giờ chạm tới trần này.
MAX_HISTORY_MESSAGES=200
MAX_MESSAGE_LENGTH=32000

# --- Batch -----------------------------------------------------------------
MAX_BATCH_SIZE=32
