# ---------------------------------------------------------------------------
# LMDeploy Server (OpenAI-compatible API)
# ---------------------------------------------------------------------------
LM_DEPLOY_BASE_URL=http://lmdeploy-server:23333/v1
LM_DEPLOY_API_KEY=EMPTY
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
DEFAULT_TEMPERATURE=0.7
DEFAULT_TOP_P=0.8
DEFAULT_MAX_NEW_TOKENS=512
LLM_REQUEST_TIMEOUT=120

# ---------------------------------------------------------------------------
# RAG
# ---------------------------------------------------------------------------
# Bật/tắt truy hồi RAG (tắt để chạy API như LLM proxy thuần).
RAG_ENABLED=true
RAG_TOP_K=5
# Bảng chunk + vector trong vector DB (khớp db_table của RagChunkData).
RAG_CHUNK_TABLE=rag_chunkdata
# Model embedding để vector hoá câu hỏi. PHẢI khớp với model lúc index dữ liệu.
EMBEDDING_MODEL=bkai-foundation-models/vietnamese-bi-encoder
# 0 = tự động lấy số chiều theo model (không kiểm tra).
EMBEDDING_DIM=0
# Bật để raise lỗi khi số chiều embedding lệch EMBEDDING_DIM (khuyến nghị ở prod).
STRICT_EMBEDDING_DIM=false
EMBEDDING_BATCH_SIZE=32

# ---------------------------------------------------------------------------
# Batch
# ---------------------------------------------------------------------------
MAX_BATCH_SIZE=32

# ---------------------------------------------------------------------------
# Database (vector DB chứa rag_chunkdata)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://vector_user:vector_password@localhost:5432/vector_db
